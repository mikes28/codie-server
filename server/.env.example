# Codie web-backend configuration — copy to .env and fill in.
# The repo root .env (shared with the Python side) is also loaded.

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- BLE ---
# The Bluetooth adapter (hci0 / hci1 ...).
CODIE_ADAPTER=hci0

# The robot's advertised name — the filter uses this prefix (case-insensitive).
CODIE_ROBOT_NAME=Codie

# Advertised service UUIDs (routing + no-routing generations).
CODIE_ROBOT_UUIDS=52af0001-978a-628d-c845-0a104ca2b8dd,d46e7e53-ba2f-4044-ade9-f85ead45f458

# Optional MAC allowlist (comma-separated). Empty = every Codie passes.
CODIE_MAC_ALLOWLIST=

# If 1, the allowlist alone is enough (name/UUID check skipped).
CODIE_MAC_ONLY=0

# --- Timings (ms) ---
CODIE_SCAN_MS=10000
CODIE_SCAN_WINDOW_MS=8000
CODIE_CONNECT_TIMEOUT_MS=20000
CODIE_CONNECT_RETRIES=3
CODIE_RETRY_DELAY_MS=3000
CODIE_TELEMETRY_MS=250
CODIE_RESPONSE_TIMEOUT_MS=2500
CODIE_QUERY_TIMEOUT_MS=1200
CODIE_WRITE_TIMEOUT_MS=3000
CODIE_STATUS_TIMEOUT_MS=10000
CODIE_WRITE_GAP_MS=50
CODIE_MIC_MS=200

# --- Reconnection ---
CODIE_AUTO_RECONNECT=1
CODIE_RECONNECT_ATTEMPTS=3
CODIE_RECONNECT_DELAY_MS=5000

# Robots to auto-connect on startup (comma-separated addresses).
CODIE_AUTO_CONNECT=

# --- Robot scripts (Python communication script) ---
CODIE_PYTHON=python3
CODIE_SCRIPT_TIMEOUT_MS=120000
